  "label": {
    "id": "689:117",
    "text": "SELECTED JOURNALISM WORK"
  },
  "written": {
    "heading": {
      "id": "607:16",
      "text": "Written Articles"
    },
    "description": {
      "id": "607:14",
      "text": "Writing gives me a way to explore topics, reflect on experiences, and share perspectives. This collection brings together reported features and personal reflections, shaped by curiosity, conversations, and a closer look at the world around me."
    }
  },
  "multimedia": {
    "key": "journalism-multimedia",
    "heading": {
      "id": "689:8",
      "text": "Multimedia Journalism"
    },
    "body": {
      "id": "689:7",
      "text": "As anti-Asian hate incidents escalated across the U.S., I led a team of student journalists to create a multimedia news package documenting their impact and the community’s response.\n\nI built the website and assembled the full package, coordinated articles and podcasts, produced the video, contributed photography, and created an incident timeline, personal accounts section, and donation and involvement resources.\n\nThe project won the National Scholastic Press Association’s Multimedia News Story of the Year award.",
      "width": 490
    },
    "href": "https://scotscenterchs.wixsite.com/aapi",
    "prototypeId": "689:9",
    "button": {
      "id": "689:9",
      "label": {
        "id": "689:11",
        "text": "SEE MULTIMEDIA PACKAGE ↗"
      },
