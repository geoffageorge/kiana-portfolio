  "broadcast": {
    "heading": {
      "id": "689:13",
      "text": "Broadcast Journalism"
    },
    "description": {
      "id": "689:12",
      "text": "I use video to explore the people, places, and ideas that make a community. I take each story from concept to final edit, handling research, interviews, on-location filming, photography, and video editing."
    },
