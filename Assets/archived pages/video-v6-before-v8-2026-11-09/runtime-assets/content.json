    {
      "key": "multimedia",
      "heading": {
        "id": "610:26",
        "text": "Multimedia Journalism"
      },
      "body": {
        "id": "610:25",
        "text": "As anti-Asian hate incidents escalated across the U.S., I led a \nteam of student journalists to create a multimedia news package documenting their impact and the community’s response.\n\nI built the website and assembled the full package, coordinated articles and podcasts, produced the video, contributed photography, and created an incident timeline, personal accounts section, and donation and involvement resources.\n\nThe project won the National Scholastic Press Association’s Multimedia News Story of the Year award.",
        "width": 529
      },
      "href": "https://scotscenterchs.wixsite.com/aapi",
      "prototypeId": "612:123",
      "button": {
        "id": "612:123",
        "label": {
          "id": "610:28",
          "text": "SEE MULTIMEDIA PACKAGE ↗"
        },
        "width": 239,
        "height": 31,
        "labelWidth": 223,
        "gap": 40
      },
      "image": {
