      "width": 845,
      "height": 105,
      "visible": true,
      "text": "Reflection",
      "fontSize": 24
    },
    {
      "id": "413:11",
      "parent": "413:70",
      "name": "Line 72",
      "type": "LINE",
      "x": 426,
      "y": 9402,
      "width": 892,
