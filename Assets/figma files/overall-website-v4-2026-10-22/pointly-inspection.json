      "parent": "413:68",
      "type": "TEXT",
      "x": 425,
      "y": 7338,
      "width": 856,
      "height": 78,
      "visible": true,
      "text": "I developed Point.ly’s visual identity and core interface—including color, typography, illustration, and layout—to make credit card points feel clear and approachable, balancing warmth with financial credibility. ",
      "fontSize": 16
    },
