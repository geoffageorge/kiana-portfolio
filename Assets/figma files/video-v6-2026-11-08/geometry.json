    {
      "id": "610:33",
      "name": "I worked with Obayashi North America’s HR team to create a video giving prospective candidates an inside look at the company’s culture and employee experience. My role included conducting employee interviews, filming, and editing the final video.",
      "type": "TEXT",
      "parentId": "609:115",
      "x": 121,
      "y": 393,
      "width": 546,
      "height": 104
    },
    {
      "id": "610:25",
      "name": "As anti-Asian hate incidents escalated across the U.S., I led a  team of student journalists to create a multimedia news package documenting their impact and the community’s response.  I built the website and assembled the full package, coordinated articles and podcasts, produced the video, contributed photography, and created an incident timeline, personal accounts section, and donation and involvement resources.  The project won the National Scholastic Press Association’s Multimedia News Story of the Year award.",
      "type": "TEXT",
      "parentId": "609:115",
      "x": 121,
      "y": 874,
      "width": 529,
      "height": 286
    },
